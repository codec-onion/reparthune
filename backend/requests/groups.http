@baseUrl = http://localhost:{{$dotenv PORT}}

# Inscription du compte de test : une seule fois (ensuite 409 EMAIL_ALREADY_EXISTS)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{$dotenv TEST_EMAIL}}",
  "name": "Matthieu",
  "password": "{{$dotenv TEST_MDP}}"
}

###
# Connexion : à lancer en premier, le token est réutilisé par les requêtes suivantes
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv TEST_EMAIL}}",
  "password": "{{$dotenv TEST_MDP}}"
}

### Création d'un groupe : cas nominal (attendu : 201)
POST {{baseUrl}}/group/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Vacances à Annecy",
  "currency": "EUR",
  "creator": { "name": "Matthieu", "shares": 1 },
  "members": [
    { "name": "Alice", "shares": 1 },
    { "name": "Bob", "shares": 2 }
  ]
}

### Sans token (attendu : 401 UNAUTHORIZED)
POST {{baseUrl}}/group/create
Content-Type: application/json

{
  "name": "Sans token",
  "creator": { "name": "Matthieu", "shares": 1 },
  "members": []
}

### Sans nom (attendu : 400 VALIDATION_ERROR)
POST {{baseUrl}}/group/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "currency": "EUR",
  "creator": { "name": "Matthieu", "shares": 1 },
  "members": [{ "name": "Alice", "shares": 1 }]
}

### Sans devise (attendu : 201, currency "EUR")
POST {{baseUrl}}/group/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Devise par défaut",
  "creator": { "name": "Matthieu", "shares": 1 },
  "members": [{ "name": "Alice", "shares": 1 }]
}

### Parts au-dessus du maximum (attendu : 400 VALIDATION_ERROR)
POST {{baseUrl}}/group/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Trop de parts",
  "creator": { "name": "Matthieu", "shares": 100 },
  "members": [{ "name": "Alice", "shares": 1 }]
}

### Aucun autre membre (comportement à décider : le créateur seul suffit-il ?)
POST {{baseUrl}}/group/create
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "Groupe solo",
  "creator": { "name": "Matthieu", "shares": 1 },
  "members": []
}
